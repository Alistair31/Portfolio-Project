flowchart TD
    subgraph Client["Flutter Mobile App"]
        Student(["Student"])
        Staff(["Staff — Teacher / Director-CPE / Rectorat"])
        Parent(["Parent"])
    end

    subgraph API["Next.js REST API"]
        Auth["Authentication<br/>JWT (1h) + Refresh Tokens (30d, rotated)"]
        RateLimit["Rate Limiting<br/>login / register / admin"]
        RBAC["Role-Based Access Control"]
        Anon["Anonymization<br/>per report anonymityLevel"]
    end

    ORM["Prisma ORM"]
    DB[("PostgreSQL")]
    FCM{{"Firebase Cloud Messaging"}}

    Student -- HTTPS / REST --> API
    Staff -- HTTPS / REST --> API
    Parent -- HTTPS / REST --> API

    API --> ORM --> DB

    API -- report update / new message --> FCM
    FCM -. push notification .-> Student
    FCM -. push notification .-> Staff

